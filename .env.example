PET_BRIDGE_HOST=127.0.0.1
PET_BRIDGE_PORT=17366
PET_BRIDGE_LOG=./events.jsonl
PET_BRIDGE_STATE=./bridge-state.json

# Set this if the bridge is reachable over LAN or through an untrusted local path.
# Clients may send it as Authorization: Bearer <token>, x-pet-bridge-token, or ?token=<token>.
PET_BRIDGE_TOKEN=

# Keep raw upstream payloads out of logs by default.
PET_BRIDGE_STORE_RAW=0
PET_BRIDGE_MAX_BODY_BYTES=65536
PET_BRIDGE_MAX_MESSAGE_CHARS=500
PET_BRIDGE_SINK_TIMEOUT_MS=1200
PET_BRIDGE_OUTBOX_MAX=300
PET_BRIDGE_OUTBOX_FLUSH_MAX=25

# Reminder behavior.
PET_NOTIFY_STATUSES=needs-attention,completed,near-complete,error
PET_NOTIFY_THROTTLE_MS=15000

# Optional outbound sinks.
PET_WEBHOOK_URL=
PET_NOTIFICATION_WEBHOOK_URL=
PET_WEBHOOK_TOKEN=

# Optional XiaoZhi assistant hub sink.
# Sends normalized events to <url>/assistant/notifications and lets the Mac mini
# backend decide screen colors, green completion flash, brightness, and ack state.
XIAOZHI_ASSISTANT_URL=
XIAOZHI_SOURCE_PREFIX=
XIAOZHI_WEBHOOK_TOKEN=

# Optional local client spooler used by hooks and lightweight sync daemons.
PET_NOTIFY_QUEUE=~/.codex-pet-bridge/notify-outbox.jsonl
PET_NOTIFY_TIMEOUT_MS=1200
PET_AGENT_SYNC_PREFIX=local
PET_AGENT_SYNC_INTERVAL_MS=15000
PET_CLAUDE_TURN_STATE=~/.codex-pet-bridge/claude-turn.json

# Quiet gate. Nothing is published while it is active, so background agent
# activity cannot light a screen in a dark room.
# Off unless set to 1. Set PET_QUIET_TZ too: the window is local, not UTC.
PET_QUIET_ENABLED=0
PET_QUIET_START=01:00
PET_QUIET_END=09:00
PET_QUIET_TZ=Europe/Vienna
PET_QUIET_CACHE_TTL_MS=30000

# Optional second rule: stay quiet once every room light is off, within a night
# envelope. Needs a Home Assistant read-only token.
PET_QUIET_LIGHTS_ENABLED=0
PET_QUIET_LIGHTS_ENVELOPE_START=21:00
PET_QUIET_LIGHTS_ENVELOPE_END=11:00
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_TOKEN_FILE=
# Plug and sensor backlights are light.* entities that never turn off. Left in,
# "all lights off" is never true and the rule silently does nothing.
PET_QUIET_LIGHTS_EXCLUDE_SUFFIXES=_indicator_light
PET_QUIET_LIGHTS_EXCLUDE=
# A restored state is not a person flipping a switch: ignore a fresh `on` until
# it has held this long.
PET_QUIET_LIGHTS_MIN_ON_SECONDS=90
# Times when an integration is known to reconnect and replay stale states; the
# previous verdict is held across them (e.g. Xiaomi Home reconnects at 04:30).
PET_QUIET_LIGHTS_HOLD_WINDOWS=
# Unknown state inside the envelope means stay dark rather than wake someone.
PET_QUIET_LIGHTS_FAIL_CLOSED=1
